import * as html from "std/web/html"

pub fn labelStyle -> html.Style =
  html.style {
    color: "#7a8498",
    fontSize: "13px",
    fontWeight: "600",
    letterSpacing: "0.08em",
    margin: "0 0 8px",
    textTransform: "uppercase",
  }

pub fn descriptionStyle -> html.Style =
  html.style {
    color: "#4f5b70",
    fontSize: "16px",
    lineHeight: "1.55",
    margin: "0",
  }

pub fn counterRowStyle -> html.Style =
  html.style {
    alignItems: "center",
    display: "flex",
    flexWrap: "wrap",
    gap: "16px",
    justifyContent: "space-between",
    marginTop: "20px",
  }

pub fn countStyle -> html.Style =
  html.style {
    fontSize: "clamp(42px, 12vw, 56px)",
    fontWeight: "700",
    letterSpacing: "-0.04em",
    lineHeight: "1",
    margin: "0",
  }

pub fn buttonGroupStyle -> html.Style =
  html.style {
    display: "flex",
    flexWrap: "wrap",
    gap: "10px",
    marginLeft: "auto",
    maxWidth: "100%",
  }

pub fn primaryButtonStyle -> html.Style =
  html.style {
    alignItems: "center",
    backgroundColor: "#172033",
    border: "0",
    borderRadius: "12px",
    color: "#ffffff",
    cursor: "pointer",
    display: "inline-flex",
    fontSize: "16px",
    fontWeight: "600",
    justifyContent: "center",
    minHeight: "44px",
    minWidth: "64px",
    padding: "10px 18px",
    touchAction: "manipulation",
    userSelect: "none",
  }

pub fn secondaryButtonStyle -> html.Style =
  html.style {
    alignItems: "center",
    backgroundColor: "#eef2f7",
    border: "0",
    borderRadius: "12px",
    color: "#344054",
    cursor: "pointer",
    display: "inline-flex",
    fontSize: "16px",
    fontWeight: "600",
    justifyContent: "center",
    minHeight: "44px",
    minWidth: "72px",
    padding: "10px 18px",
    touchAction: "manipulation",
    userSelect: "none",
  }
