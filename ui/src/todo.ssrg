import * as html from "std/web/html"
import * as styles from "./styles"

pub struct Todo {
  id: Int,
  title: String,
  completed: Bool,
}

pub type Action =
  | DraftChanged String
  | AddTodo
  | ToggleTodo Int
  | DeleteTodo Int

pub struct TodoActions<A> {
  draftChanged: String -> A,
  addTodo: A,
  toggleTodo: Int -> A,
  deleteTodo: Int -> A,
}

fn defaultActions -> TodoActions<Action> =
  TodoActions {
    draftChanged: DraftChanged,
    addTodo: AddTodo,
    toggleTodo: ToggleTodo,
    deleteTodo: DeleteTodo,
  }

fn statusText todo: Todo -> String =
  if todo.completed then "Done" else "Open"

fn todoTitleStyle todo: Todo -> html.Style =
  if todo.completed then styles.completedTitleStyle () else styles.todoTitleStyle ()

fn todoItemWith<A> actions: TodoActions<A> -> todo: Todo -> html.Html<A> =
  html.li {
    style: styles.todoItemStyle (),
    children: [
      html.button {
        buttonType: "button",
        style: styles.toggleButtonStyle todo.completed,
        onClick: actions.toggleTodo todo.id,
        children: statusText todo
      },
      html.p {
        style: todoTitleStyle todo,
        children: todo.title
      },
      html.button {
        buttonType: "button",
        style: styles.deleteButtonStyle (),
        onClick: actions.deleteTodo todo.id,
        children: "Delete"
      }
    ]
  }

pub fn listWith<A> actions: TodoActions<A> -> todos: Array<Todo> -> html.Html<A> =
  html.ul {
    id: "todo-list",
    style: styles.todoListStyle (),
    children: map (todoItemWith actions) todos
  }

pub fn viewWith<A> actions: TodoActions<A>
  -> todos: Array<Todo>
  -> draft: String
  -> html.Html<A> =
  html.section {
    id: "todo-app",
    style: styles.todoCardStyle (),
    children: [
      html.div {
        style: styles.todoHeaderStyle (),
        children: [
          html.div {
            children: [
              html.p {
                style: styles.labelStyle (),
                children: "SQLite-backed interaction"
              },
              html.h2 {
                style: styles.todoHeadingStyle (),
                children: "Things to do"
              }
            ]
          },
          html.span {
            style: styles.databaseBadgeStyle (),
            children: "SQLite"
          }
        ]
      },
      html.p {
        style: styles.descriptionStyle (),
        children: "The initial list is read from SQLite during SSR. After hydration, mutations go through the Seseragi HTTP server and the list region updates reactively."
      },
      html.div {
        style: styles.composerStyle (),
        children: [
          html.input {
            id: "todo-input",
            inputType: "text",
            value: draft,
            placeholder: "Add a task",
            autoComplete: "off",
            style: styles.inputStyle (),
            onInput: \event -> actions.draftChanged event.value
          },
          html.button {
            buttonType: "button",
            style: styles.addButtonStyle (),
            onClick: actions.addTodo,
            children: "Add"
          }
        ]
      },
      listWith actions todos,
      html.p {
        style: styles.noteStyle (),
        children: "Ephemeral container SQLite · data may reset when the deployment or instance restarts."
      }
    ]
  }

pub fn list todos: Array<Todo> -> html.Html<Action> =
  listWith (defaultActions ()) todos

pub fn view todos: Array<Todo> -> draft: String -> html.Html<Action> =
  viewWith (defaultActions ()) todos draft
