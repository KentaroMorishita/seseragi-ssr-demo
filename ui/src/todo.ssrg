import * as html from "std/web/html"
import * as styles from "./styles"

pub struct Todo {
  id: Int,
  title: String,
  completed: Bool,
}

fn statusText todo: Todo -> String =
  if todo.completed then "Done" else "Open"

fn todoTitleStyle todo: Todo -> html.Style =
  if todo.completed then styles.completedTitleStyle () else styles.todoTitleStyle ()

fn todoItem<Action>
  toggleTodo: Int -> Action
  -> deleteTodo: Int -> Action
  -> todo: Todo
  -> html.Html<Action> =
  html.li {
    style: styles.todoItemStyle (),
    children: [
      html.button {
        buttonType: "button",
        style: styles.toggleButtonStyle todo.completed,
        onClick: toggleTodo todo.id,
        children: statusText todo
      },
      html.p {
        style: todoTitleStyle todo,
        children: todo.title
      },
      html.button {
        buttonType: "button",
        style: styles.deleteButtonStyle (),
        onClick: deleteTodo todo.id,
        children: "Delete"
      }
    ]
  }

pub fn listItems<Action>
  toggleTodo: Int -> Action
  -> deleteTodo: Int -> Action
  -> todos: Array<Todo>
  -> Array<html.Html<Action>> =
  map (todoItem toggleTodo deleteTodo) todos

pub fn listContent<Action>
  toggleTodo: Int -> Action
  -> deleteTodo: Int -> Action
  -> todos: Array<Todo>
  -> html.Html<Action> =
  html.fragment (listItems toggleTodo deleteTodo todos)

pub fn list<Action>
  toggleTodo: Int -> Action
  -> deleteTodo: Int -> Action
  -> todos: Array<Todo>
  -> html.Html<Action> =
  html.ul {
    id: "todo-list",
    style: styles.todoListStyle (),
    children: listItems toggleTodo deleteTodo todos
  }

fn composer<Action>
  draftChanged: String -> Action
  -> addTodo: Action
  -> draft: String
  -> html.Html<Action> =
  html.form {
    style: styles.composerStyle (),
    onSubmit: addTodo,
    children: [
      html.input {
        id: "todo-input",
        inputType: "text",
        value: draft,
        placeholder: "Add a task",
        autoComplete: "off",
        style: styles.inputStyle (),
        onInput: \event -> draftChanged event.value
      },
      html.button {
        buttonType: "submit",
        style: styles.addButtonStyle (),
        children: "Add"
      }
    ]
  }

pub fn islandChildren<Action>
  draftChanged: String -> Action
  -> addTodo: Action
  -> toggleTodo: Int -> Action
  -> deleteTodo: Int -> Action
  -> todos: Array<Todo>
  -> draft: String
  -> Array<html.Html<Action>> =
  [
    composer draftChanged addTodo draft,
    list toggleTodo deleteTodo todos
  ]

pub fn islandContent<Action>
  draftChanged: String -> Action
  -> addTodo: Action
  -> toggleTodo: Int -> Action
  -> deleteTodo: Int -> Action
  -> todos: Array<Todo>
  -> draft: String
  -> html.Html<Action> =
  html.fragment (islandChildren draftChanged addTodo toggleTodo deleteTodo todos draft)

pub fn island<Action>
  draftChanged: String -> Action
  -> addTodo: Action
  -> toggleTodo: Int -> Action
  -> deleteTodo: Int -> Action
  -> todos: Array<Todo>
  -> draft: String
  -> html.Html<Action> =
  html.div {
    id: "todo-interactive",
    children: islandChildren draftChanged addTodo toggleTodo deleteTodo todos draft
  }

pub fn view<Action>
  draftChanged: String -> Action
  -> addTodo: Action
  -> toggleTodo: Int -> Action
  -> deleteTodo: Int -> Action
  -> todos: Array<Todo>
  -> draft: String
  -> html.Html<Action> =
  html.section {
    id: "todo-app",
    style: styles.todoCardStyle (),
    children: [
      html.div {
        style: styles.todoHeaderStyle (),
        children: [
          html.div {
            children: [
              html.p {
                style: styles.labelStyle (),
                children: "SQLite-backed interaction"
              },
              html.h2 {
                style: styles.todoHeadingStyle (),
                children: "Things to do"
              }
            ]
          },
          html.span {
            style: styles.databaseBadgeStyle (),
            children: "SQLite"
          }
        ]
      },
      html.p {
        style: styles.descriptionStyle (),
        children: "The initial list is read from SQLite during SSR. After hydration, mutations go through the Seseragi HTTP server and the list region updates reactively."
      },
      island draftChanged addTodo toggleTodo deleteTodo todos draft,
      html.p {
        style: styles.noteStyle (),
        children: "Ephemeral container SQLite · data may reset when the deployment or instance restarts."
      }
    ]
  }
