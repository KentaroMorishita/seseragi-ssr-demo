import * as html from "std/web/html"
import * as styles from "./styles"

pub struct Todo {
  id: Int,
  title: String,
  completed: Bool,
}

pub struct TodoActions<Action> {
  draftChanged: String -> Action,
  addTodo: Action,
  toggleTodo: Int -> Action,
  deleteTodo: Int -> Action,
}

fn statusText todo: Todo -> String =
  if todo.completed then "Done" else "Open"

fn todoTitleStyle todo: Todo -> html.Style =
  if todo.completed then styles.completedTitleStyle () else styles.todoTitleStyle ()

fn todoItem<Action> actions: TodoActions<Action> -> todo: Todo -> html.Html<Action> =
  html.li {
    style: styles.todoItemStyle (),
    children: [
      html.button {
        buttonType: "button",
        style: styles.toggleButtonStyle todo.completed,
        onClick: actions.toggleTodo todo.id,
        children: statusText todo
      },
      html.p {
        style: todoTitleStyle todo,
        children: todo.title
      },
      html.button {
        buttonType: "button",
        style: styles.deleteButtonStyle (),
        onClick: actions.deleteTodo todo.id,
        children: "Delete"
      }
    ]
  }

pub fn listItems<Action> actions: TodoActions<Action>
  -> todos: Array<Todo>
  -> Array<html.Html<Action>> =
  map (todoItem actions) todos

pub fn listContent<Action> actions: TodoActions<Action>
  -> todos: Array<Todo>
  -> html.Html<Action> =
  html.fragment (listItems actions todos)

pub fn list<Action> actions: TodoActions<Action>
  -> todos: Array<Todo>
  -> html.Html<Action> =
  html.ul {
    id: "todo-list",
    style: styles.todoListStyle (),
    children: listItems actions todos
  }

fn composer<Action> actions: TodoActions<Action>
  -> draft: String
  -> html.Html<Action> =
  html.form {
    style: styles.composerStyle (),
    onSubmit: actions.addTodo,
    children: [
      html.input {
        id: "todo-input",
        inputType: "text",
        value: draft,
        placeholder: "Add a task",
        autoComplete: "off",
        style: styles.inputStyle (),
        onInput: \event -> actions.draftChanged event.value
      },
      html.button {
        buttonType: "submit",
        style: styles.addButtonStyle (),
        children: "Add"
      }
    ]
  }

pub fn islandChildren<Action> actions: TodoActions<Action>
  -> todos: Array<Todo>
  -> draft: String
  -> Array<html.Html<Action>> =
  [
    composer actions draft,
    list actions todos
  ]

pub fn islandContent<Action> actions: TodoActions<Action>
  -> todos: Array<Todo>
  -> draft: String
  -> html.Html<Action> =
  html.fragment (islandChildren actions todos draft)

pub fn island<Action> actions: TodoActions<Action>
  -> todos: Array<Todo>
  -> draft: String
  -> html.Html<Action> =
  html.div {
    id: "todo-interactive",
    children: islandChildren actions todos draft
  }

pub fn view<Action> actions: TodoActions<Action>
  -> todos: Array<Todo>
  -> draft: String
  -> html.Html<Action> =
  html.section {
    id: "todo-app",
    style: styles.todoCardStyle (),
    children: [
      html.div {
        style: styles.todoHeaderStyle (),
        children: [
          html.div {
            children: [
              html.p {
                style: styles.labelStyle (),
                children: "SQLite-backed interaction"
              },
              html.h2 {
                style: styles.todoHeadingStyle (),
                children: "Things to do"
              }
            ]
          },
          html.span {
            style: styles.databaseBadgeStyle (),
            children: "SQLite"
          }
        ]
      },
      html.p {
        style: styles.descriptionStyle (),
        children: "The initial list is read from SQLite during SSR. After hydration, mutations go through the Seseragi HTTP server and the list region updates reactively."
      },
      island actions todos draft,
      html.p {
        style: styles.noteStyle (),
        children: "Ephemeral container SQLite · data may reset when the deployment or instance restarts."
      }
    ]
  }
