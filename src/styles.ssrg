import * as html from "std/web/html"

pub fn pageStyle -> html.Style =
  html.style {
    backgroundColor: "#f5f7fb",
    color: "#172033",
    fontFamily: "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    margin: "0",
    minHeight: "100vh",
    textSizeAdjust: "100%",
  }

pub fn shellStyle -> html.Style =
  html.style {
    boxSizing: "border-box",
    marginLeft: "auto",
    marginRight: "auto",
    maxWidth: "920px",
    padding: "clamp(32px, 8vw, 72px) clamp(16px, 5vw, 24px)",
    width: "100%",
  }

pub fn badgeRowStyle -> html.Style =
  html.style {
    display: "flex",
    flexWrap: "wrap",
    gap: "8px",
    marginBottom: "24px",
  }

pub fn badgeStyle -> html.Style =
  html.style {
    backgroundColor: "#e8f0ff",
    borderRadius: "999px",
    color: "#315fc6",
    display: "inline-block",
    fontSize: "13px",
    fontWeight: "700",
    padding: "8px 11px",
  }

pub fn sqliteBadgeStyle -> html.Style =
  html.style {
    backgroundColor: "#ecfdf3",
    borderRadius: "999px",
    color: "#067647",
    display: "inline-block",
    fontSize: "13px",
    fontWeight: "700",
    padding: "8px 11px",
  }

pub fn titleStyle -> html.Style =
  html.style {
    fontSize: "clamp(42px, 11vw, 82px)",
    fontWeight: "700",
    letterSpacing: "-0.05em",
    lineHeight: "0.96",
    margin: "0",
    overflowWrap: "anywhere",
  }

pub fn leadStyle -> html.Style =
  html.style {
    color: "#5a6478",
    fontSize: "clamp(17px, 4vw, 20px)",
    lineHeight: "1.65",
    marginBottom: "clamp(28px, 6vw, 40px)",
    marginTop: "clamp(22px, 5vw, 28px)",
    maxWidth: "720px",
  }

pub fn cardStyle -> html.Style =
  html.style {
    backgroundColor: "#ffffff",
    border: "1px solid #e2e7f0",
    borderRadius: "18px",
    boxSizing: "border-box",
    padding: "18px 20px",
    width: "100%",
  }

pub fn labelStyle -> html.Style =
  html.style {
    color: "#7a8498",
    fontSize: "12px",
    fontWeight: "700",
    letterSpacing: "0.08em",
    margin: "0 0 7px",
    textTransform: "uppercase",
  }

pub fn pathStyle -> html.Style =
  html.style {
    color: "#172033",
    fontFamily: "ui-monospace, SFMono-Regular, Menlo, monospace",
    fontSize: "clamp(15px, 4vw, 18px)",
    margin: "0",
    overflowWrap: "anywhere",
  }
