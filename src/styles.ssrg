import * as html from "std/web/html"

pub fn pageStyle -> html.Style =
  html.style {
    backgroundColor: "#f5f7fb",
    color: "#172033",
    fontFamily: "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    margin: "0",
    minHeight: "100vh",
    textSizeAdjust: "100%",
  }

pub fn shellStyle -> html.Style =
  html.style {
    boxSizing: "border-box",
    marginLeft: "auto",
    marginRight: "auto",
    maxWidth: "920px",
    padding: "clamp(32px, 8vw, 72px) clamp(16px, 5vw, 24px)",
    width: "100%",
  }

pub fn badgeStyle -> html.Style =
  html.style {
    backgroundColor: "#e8f0ff",
    borderRadius: "999px",
    color: "#315fc6",
    display: "inline-block",
    fontSize: "14px",
    fontWeight: "600",
    marginBottom: "24px",
    padding: "8px 12px",
  }

pub fn titleStyle -> html.Style =
  html.style {
    fontSize: "clamp(42px, 11vw, 86px)",
    fontWeight: "700",
    letterSpacing: "-0.05em",
    lineHeight: "0.95",
    margin: "0",
    overflowWrap: "anywhere",
  }

pub fn leadStyle -> html.Style =
  html.style {
    color: "#5a6478",
    fontSize: "clamp(17px, 4vw, 20px)",
    lineHeight: "1.65",
    marginBottom: "clamp(28px, 6vw, 40px)",
    marginTop: "clamp(22px, 5vw, 28px)",
    maxWidth: "680px",
  }

pub fn cardStyle -> html.Style =
  html.style {
    backgroundColor: "#ffffff",
    border: "1px solid #e2e7f0",
    borderRadius: "clamp(18px, 4vw, 24px)",
    boxSizing: "border-box",
    padding: "clamp(20px, 5vw, 28px)",
    width: "100%",
  }

pub fn interactiveCardStyle -> html.Style =
  html.style {
    backgroundColor: "#ffffff",
    border: "1px solid #e2e7f0",
    borderRadius: "clamp(18px, 4vw, 24px)",
    boxSizing: "border-box",
    marginTop: "20px",
    padding: "clamp(20px, 5vw, 28px)",
    width: "100%",
  }

pub fn labelStyle -> html.Style =
  html.style {
    color: "#7a8498",
    fontSize: "13px",
    fontWeight: "600",
    letterSpacing: "0.08em",
    margin: "0 0 8px",
    textTransform: "uppercase",
  }

pub fn pathStyle -> html.Style =
  html.style {
    color: "#172033",
    fontFamily: "ui-monospace, SFMono-Regular, Menlo, monospace",
    fontSize: "clamp(16px, 4vw, 20px)",
    margin: "0",
    overflowWrap: "anywhere",
  }
