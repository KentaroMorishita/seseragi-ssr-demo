import * as html from "std/web/html"
import { Todo, view as todoView } from "ui"
import * as styles from "./styles"

fn ignoreDraft _value: String -> Unit = ()
fn ignoreTodo _id: Int -> Unit = ()

pub fn body _path: String -> todos: Array<Todo> -> html.Html<Unit> =
  html.body {
    style: styles.pageStyle (),
    children: html.main {
      style: styles.shellStyle (),
      children: [
        html.div {
          style: styles.badgeRowStyle (),
          children: [
            html.span {
              style: styles.badgeStyle (),
              children: "SSR + Hydration"
            },
            html.span {
              style: styles.sqliteBadgeStyle (),
              children: "SQLite on Bun"
            }
          ]
        },
        html.h1 {
          style: styles.titleStyle (),
          children: "Seseragi Todo"
        },
        html.p {
          style: styles.leadStyle (),
          children: "The server reads SQLite before rendering this page. The browser hydrates only the interactive Todo island and sends mutations back through Seseragi HTTP."
        },
        todoView ignoreDraft () ignoreTodo ignoreTodo todos ""
      ]
    }
  }
