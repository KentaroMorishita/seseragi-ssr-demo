import * as html from "std/web/html"

type Action =
  | Noop

fn pageStyle -> html.Style =
  html.style {
    backgroundColor: "#f5f7fb",
    color: "#172033",
    fontFamily: "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    margin: "0",
    minHeight: "100vh",
  }

fn shellStyle -> html.Style =
  html.style {
    boxSizing: "border-box",
    marginLeft: "auto",
    marginRight: "auto",
    maxWidth: "920px",
    padding: "72px 24px",
  }

fn badgeStyle -> html.Style =
  html.style {
    backgroundColor: "#e8f0ff",
    borderRadius: "999px",
    color: "#315fc6",
    display: "inline-block",
    fontSize: "14px",
    fontWeight: "600",
    marginBottom: "24px",
    padding: "8px 12px",
  }

fn titleStyle -> html.Style =
  html.style {
    fontSize: "clamp(48px, 8vw, 86px)",
    fontWeight: "700",
    letterSpacing: "-0.05em",
    lineHeight: "0.95",
    margin: "0",
  }

fn leadStyle -> html.Style =
  html.style {
    color: "#5a6478",
    fontSize: "20px",
    lineHeight: "1.7",
    marginBottom: "40px",
    marginTop: "28px",
    maxWidth: "680px",
  }

fn cardStyle -> html.Style =
  html.style {
    backgroundColor: "#ffffff",
    border: "1px solid #e2e7f0",
    borderRadius: "24px",
    boxSizing: "border-box",
    padding: "28px",
  }

fn labelStyle -> html.Style =
  html.style {
    color: "#7a8498",
    fontSize: "13px",
    fontWeight: "600",
    letterSpacing: "0.08em",
    margin: "0 0 8px",
    textTransform: "uppercase",
  }

fn pathStyle -> html.Style =
  html.style {
    color: "#172033",
    fontFamily: "ui-monospace, SFMono-Regular, Menlo, monospace",
    fontSize: "20px",
    margin: "0",
  }

pub fn page path: String -> html.Html<Action> =
  html.html {
    lang: "en",
    children: [
      html.head {
        children: html.title { children: "Seseragi SSR Demo" }
      },
      html.body {
        style: pageStyle (),
        children: html.main {
          style: shellStyle (),
          children: [
            html.span {
              style: badgeStyle (),
              children: "Rendered on the server"
            },
            html.h1 {
              style: titleStyle (),
              children: "Seseragi SSR"
            },
            html.p {
              style: leadStyle (),
              children: "A pure Html tree is rendered to a string by Seseragi, then returned directly from std/http/server. No JSX, framework runtime, or template engine."
            },
            html.section {
              style: cardStyle (),
              children: [
                html.p {
                  style: labelStyle (),
                  children: "Request path"
                },
                html.p {
                  style: pathStyle (),
                  children: path
                }
              ]
            }
          ]
        }
      }
    ]
  }

pub fn render path: String -> String =
  `<!doctype html>${html.renderToString (page path)}`
