import * as deferred from "std/deferred"
import * as effects from "std/effect"
import * as http from "std/http/server"
import * as store from "./todo_store"
import * as todoHttp from "./todo_http"

pub effect fn main =
  do {
    database <- store.openDatabase ()
    _ <- http.listen {
      hostname: "0.0.0.0",
      port: 3001,
      handler: todoHttp.handler database
    }
    |> effects.mapError (\error: http.HttpServerError -> http.errorMessage error)
    keepAlive <- deferred.make<Never, Unit> ()
      |> effects.mapError (\_error: Never -> "unreachable")
    deferred.await keepAlive
      |> effects.mapError (\_error: Never -> "unreachable")
  }
