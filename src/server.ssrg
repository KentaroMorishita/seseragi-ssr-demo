import * as deferred from "std/deferred"
import * as effects from "std/effect"
import * as http from "std/http/server"
import * as ints from "std/int"
import * as json from "std/json"
import * as sqlite from "sqlite"
import * as text from "std/text"
import {
  Database,
  Db,
  FileConfig,
  Sqlite as SqliteService,
  Statement,
} from "sqlite"
import { Todo } from "ui"
import { render } from "./document"

struct RequestContext {
  database: Database,
  request: http.HttpServerRequest,
}

struct CreateCommand {
  context: RequestContext,
  title: String,
}

struct TodoIdCommand {
  context: RequestContext,
  id: Int,
}

struct FixedResponse {
  context: RequestContext,
  response: http.HttpServerResponse,
}

fn serverFailure error: http.HttpServerError =
  sqlite.failure "http-server" "HTTP_SERVER" (http.errorMessage error)

fn neverFailure _error: Never =
  sqlite.failure "runtime" "NEVER" "unreachable failure"

fn statement sql: String -> values: Array<sqlite.Value> -> Statement =
  Statement { sql: sql, values: values }

fn todosStatement -> Statement =
  statement
    "select id, title, completed from todos order by id desc"
    (sqlite.emptyValues ())

fn todoStart id: Int -> title: String -> (Bool -> Todo) =
  \completed -> Todo { id: id, title: title, completed: completed }

fn finishTodo build: (Bool -> Todo) -> completed: Bool -> Todo =
  build completed

fn todoDecoder -> sqlite.Decoder<Todo> =
  sqlite.map2 finishTodo
    (sqlite.map2 todoStart (sqlite.int "id") (sqlite.string "title"))
    (sqlite.bool "completed")

fn jsonTodo todo: Todo -> { id: Int, title: String, completed: Bool } =
  { id: todo.id, title: todo.title, completed: todo.completed }

fn todosResponse todos: Array<Todo> -> http.HttpServerResponse =
  http.jsonResponse 200 [] (json.encodeString (map jsonTodo todos))

fn htmlResponse path: String -> todos: Array<Todo> -> http.HttpServerResponse =
  http.textResponse 200
    [http.header "content-type" "text/html; charset=utf-8"]
    (render path todos)

fn badRequest message: String -> http.HttpServerResponse =
  http.textResponse 400
    [http.header "content-type" "text/plain; charset=utf-8"]
    message

fn databaseError _error =
  http.textResponse 500
    [http.header "content-type" "text/plain; charset=utf-8"]
    "SQLite operation failed"

fn parseTodoId request: http.HttpServerRequest -> Either<String, Int> =
  match text.decodeUtf8 (http.requestBody request) {
    Left _ -> Left "todo id must be an integer"
    Right idText ->
      match ints.parse idText {
        Left _ -> Left "todo id must be an integer"
        Right id -> Right id
      }
  }

fn openDatabase -> Db<Database> =
  do {
    database <- sqlite.openFile (FileConfig {
      filename: "/tmp/seseragi-ssr-demo.sqlite",
      readOnly: False,
      create: True,
      busyTimeoutMillis: 1000,
    })
    _ <- sqlite.execute database (
      statement
        "create table if not exists todos (id integer primary key autoincrement, title text not null, completed integer not null default 0)"
        (sqlite.emptyValues ())
    )
    _ <- sqlite.execute database (
      statement
        "insert or ignore into todos (id, title, completed) values (?, ?, ?)"
        [sqlite.intValue 1, sqlite.textValue "Ship server-rendered HTML", sqlite.boolValue True]
    )
    _ <- sqlite.execute database (
      statement
        "insert or ignore into todos (id, title, completed) values (?, ?, ?)"
        [sqlite.intValue 2, sqlite.textValue "Hydrate the Todo UI", sqlite.boolValue True]
    )
    _ <- sqlite.execute database (
      statement
        "insert or ignore into todos (id, title, completed) values (?, ?, ?)"
        [sqlite.intValue 3, sqlite.textValue "Persist this list in SQLite", sqlite.boolValue False]
    )
    sqlite.succeed database
  }

fn listTodos database: Database -> Db<Array<Todo>> =
  do {
    result <- sqlite.query database (todosStatement ()) (todoDecoder ())
    sqlite.succeed result.rows
  }

fn fixedResponse command: FixedResponse -> Db<http.HttpServerResponse> =
  do {
    _ <- listTodos command.context.database
    sqlite.succeed command.response
  }

fn insertTodo command: CreateCommand -> Db<http.HttpServerResponse> =
  do {
    _ <- sqlite.execute command.context.database (
      statement
        "insert into todos (title, completed) values (?, ?)"
        [sqlite.textValue command.title, sqlite.boolValue False]
    )
    todos <- listTodos command.context.database
    sqlite.succeed (todosResponse todos)
  }

fn createTodo context: RequestContext -> Db<http.HttpServerResponse> =
  match text.decodeUtf8 (http.requestBody context.request) {
    Left _ -> fixedResponse (FixedResponse {
      context: context,
      response: badRequest "request body must be UTF-8",
    })
    Right title ->
      if title == "" then
        fixedResponse (FixedResponse {
          context: context,
          response: badRequest "title is required",
        })
      else
        insertTodo (CreateCommand { context: context, title: title })
  }

fn toggleById command: TodoIdCommand -> Db<http.HttpServerResponse> =
  do {
    _ <- sqlite.execute command.context.database (
      statement
        "update todos set completed = case completed when 0 then 1 else 0 end where id = ?"
        [sqlite.intValue command.id]
    )
    todos <- listTodos command.context.database
    sqlite.succeed (todosResponse todos)
  }

fn toggleTodo context: RequestContext -> Db<http.HttpServerResponse> =
  match parseTodoId context.request {
    Left message -> fixedResponse (FixedResponse {
      context: context,
      response: badRequest message,
    })
    Right id -> toggleById (TodoIdCommand { context: context, id: id })
  }

fn deleteById command: TodoIdCommand -> Db<http.HttpServerResponse> =
  do {
    _ <- sqlite.execute command.context.database (
      statement "delete from todos where id = ?" [sqlite.intValue command.id]
    )
    todos <- listTodos command.context.database
    sqlite.succeed (todosResponse todos)
  }

fn deleteTodo context: RequestContext -> Db<http.HttpServerResponse> =
  match parseTodoId context.request {
    Left message -> fixedResponse (FixedResponse {
      context: context,
      response: badRequest message,
    })
    Right id -> deleteById (TodoIdCommand { context: context, id: id })
  }

fn listResponse context: RequestContext -> Db<http.HttpServerResponse> =
  do {
    todos <- listTodos context.database
    sqlite.succeed (todosResponse todos)
  }

fn pageResponse context: RequestContext -> Db<http.HttpServerResponse> =
  do {
    todos <- listTodos context.database
    sqlite.succeed (htmlResponse (http.requestPath context.request) todos)
  }

fn responseFor context: RequestContext -> Db<http.HttpServerResponse> = {
  let method = http.requestMethod context.request
  let path = http.requestPath context.request

  if path == "/health" then
    fixedResponse (FixedResponse {
      context: context,
      response: http.textResponse 200 [] "ok",
    })
  else if method == "GET" && path == "/api/todos" then
    listResponse context
  else if method == "POST" && path == "/api/todos" then
    createTodo context
  else if method == "POST" && path == "/api/todos/toggle" then
    toggleTodo context
  else if method == "POST" && path == "/api/todos/delete" then
    deleteTodo context
  else if method == "GET" then
    pageResponse context
  else
    fixedResponse (FixedResponse {
      context: context,
      response: http.textResponse 405 [] "method not allowed",
    })
}

fn handler database: Database =
  http.recoverHandler databaseError (
    \request: http.HttpServerRequest ->
      responseFor (RequestContext { database: database, request: request })
  )

pub effect fn run =
  do {
    database <- openDatabase ()
    _ <- http.listen {
      hostname: "0.0.0.0",
      port: 3001,
      handler: handler database
    }
    |> effects.mapError serverFailure
    keepAlive <- deferred.make<Never, Unit> () |> effects.mapError neverFailure
    deferred.await keepAlive |> effects.mapError neverFailure
  }
