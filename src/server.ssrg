import * as deferred from "std/deferred"
import * as effects from "std/effect"
import * as http from "std/http/server"
import * as ints from "std/int"
import * as json from "std/json"
import * as sqlite from "sqlite"
import * as text from "std/text"
import { Todo } from "ui"
import { render } from "./document"
import { CreateTodo, TodoById } from "./todo_store"
import * as store from "./todo_store"

fn serverFailure error: http.HttpServerError -> String =
  http.errorMessage error

fn databaseFailure error: sqlite.Error -> String =
  "SQLite operation failed"

fn jsonTodo todo: Todo -> { id: Int, title: String, completed: Bool } =
  { id: todo.id, title: todo.title, completed: todo.completed }

fn todosResponse todos: Array<Todo> -> http.HttpServerResponse =
  http.jsonResponse 200 [] (json.encodeString (map jsonTodo todos))

fn badRequest message: String -> http.HttpServerResponse =
  http.textResponse 400
    [http.header "content-type" "text/plain; charset=utf-8"]
    message

fn databaseError error: sqlite.Error -> http.HttpServerResponse =
  http.textResponse 500
    [http.header "content-type" "text/plain; charset=utf-8"]
    "SQLite operation failed"

effect fn createTodo database: sqlite.Database -> request: http.HttpServerRequest
  -> http.HttpServerResponse
with sqlite: sqlite.Sqlite
fails sqlite.Error =
  match text.decodeUtf8 (http.requestBody request) {
    Left _ -> effects.succeed (badRequest "request body must be UTF-8")
    Right title ->
      if title == "" then
        effects.succeed (badRequest "title is required")
      else
        do {
          todos <- store.create (CreateTodo { database: database, title: title })
          effects.succeed (todosResponse todos)
        }
  }

effect fn parseTodoId request: http.HttpServerRequest -> Int
fails Never =
  match text.decodeUtf8 (http.requestBody request) {
    Left _ -> effects.succeed (-1)
    Right idText ->
      match ints.parse idText {
        Left _ -> effects.succeed (-1)
        Right id -> effects.succeed id
      }
  }

effect fn toggleTodo database: sqlite.Database -> request: http.HttpServerRequest
  -> http.HttpServerResponse
with sqlite: sqlite.Sqlite
fails sqlite.Error =
  do {
    id <- parseTodoId request
    if id < 0 then
      effects.succeed (badRequest "todo id must be an integer")
    else
      do {
        todos <- store.toggle (TodoById { database: database, id: id })
        effects.succeed (todosResponse todos)
      }
  }

effect fn deleteTodo database: sqlite.Database -> request: http.HttpServerRequest
  -> http.HttpServerResponse
with sqlite: sqlite.Sqlite
fails sqlite.Error =
  do {
    id <- parseTodoId request
    if id < 0 then
      effects.succeed (badRequest "todo id must be an integer")
    else
      do {
        todos <- store.delete (TodoById { database: database, id: id })
        effects.succeed (todosResponse todos)
      }
  }

effect fn responseFor database: sqlite.Database -> request: http.HttpServerRequest
  -> http.HttpServerResponse
with sqlite: sqlite.Sqlite
fails sqlite.Error = {
  let method = http.requestMethod request
  let path = http.requestPath request

  if path == "/health" then
    effects.succeed (http.textResponse 200 [] "ok")
  else if method == "GET" && path == "/api/todos" then
    do {
      todos <- store.list database
      effects.succeed (todosResponse todos)
    }
  else if method == "POST" && path == "/api/todos" then
    createTodo database request
  else if method == "POST" && path == "/api/todos/toggle" then
    toggleTodo database request
  else if method == "POST" && path == "/api/todos/delete" then
    deleteTodo database request
  else if method == "GET" then
    do {
      todos <- store.list database
      effects.succeed (
        http.textResponse 200
          [http.header "content-type" "text/html; charset=utf-8"]
          (render path todos)
      )
    }
  else
    effects.succeed (http.textResponse 405 [] "method not allowed")
}

fn handler database: sqlite.Database -> http.Handler<{ sqlite: sqlite.Sqlite }, Never> =
  http.recoverHandler databaseError (responseFor database)

pub effect fn run -> Unit
with httpServer: http.HttpServer, sqlite: sqlite.Sqlite
fails String =
  do {
    database <- store.openDatabase () |> effects.mapError databaseFailure
    _ <- http.listen {
      hostname: "127.0.0.1",
      port: 3001,
      handler: handler database
    }
    |> effects.mapError serverFailure
    keepAlive <- deferred.make ()
    deferred.await keepAlive
  }
