import * as dom from "std/web/dom"
import * as effects from "std/effect"
import * as http from "std/http"
import * as navigation from "std/web/navigation"
import * as signals from "std/signal"
import { DomOptions } from "std/web/dom"
import { MutableSignal } from "std/signal"
import { Todo, TodoActions, islandContent, listContent } from "ui"
import * as api from "./api"

type Action =
  | DraftChanged String
  | AddTodo
  | ToggleTodo Int
  | DeleteTodo Int

struct DraftCommand {
  value: String,
  draft: MutableSignal<String>,
}

let actions = TodoActions<Action> {
  draftChanged: DraftChanged,
  addTodo: AddTodo,
  toggleTodo: ToggleTodo,
  deleteTodo: DeleteTodo,
}

let defaultDomOptions = dom.defaultOptions ()
let hydrationOptions: DomOptions = DomOptions {
  ...defaultDomOptions,
  hydration: dom.HydrateStrict,
  cleanup: dom.PreserveRenderedDom
}

fn neverFailure _error: Never -> String =
  "unreachable"

fn domQueryFailure error: dom.DomError -> String =
  show error

fn domFailure error: dom.DomRuntimeError<String> -> String =
  show error

fn navigationFailure error: navigation.NavigationError -> String =
  navigation.errorMessage error

fn region todos: Array<Todo> -> dom.DomContent<Action> =
  dom.content (listContent actions todos) []

fn httpClientService
  -> Effect<{ httpClient: http.HttpClient }, Never, http.HttpClient> =
  effects.service (\environment: { httpClient: http.HttpClient } -> environment.httpClient)

fn keepHttp<A> value: A -> _service: http.HttpClient -> A =
  value

fn httpContext<A> value: A
  -> Effect<{ httpClient: http.HttpClient }, String, A> =
  httpClientService ()
  |> map (keepHttp value)
  |> effects.mapError neverFailure

effect fn setDraft command: DraftCommand -> Unit
with httpClient: http.HttpClient
fails String =
  do {
    _ <- httpContext ()
    signals.set command.value command.draft
    |> effects.mapError neverFailure
  }

effect fn insertTodo origin: String
  -> title: String
  -> todos: MutableSignal<Array<Todo>>
  -> draft: MutableSignal<String>
  -> Unit
with httpClient: http.HttpClient
fails String =
  do {
    next <- api.create origin title
    _ <- signals.set next todos |> effects.mapError neverFailure
    signals.set "" draft |> effects.mapError neverFailure
  }

effect fn applyAdd origin: String
  -> todos: MutableSignal<Array<Todo>>
  -> draft: MutableSignal<String>
  -> Unit
with httpClient: http.HttpClient
fails String =
  do {
    title <- signals.read draft |> effects.mapError neverFailure
    if title == "" then
      httpContext ()
    else
      insertTodo origin title todos draft
  }

effect fn applyToggle origin: String
  -> todos: MutableSignal<Array<Todo>>
  -> id: Int
  -> Unit
with httpClient: http.HttpClient
fails String =
  do {
    next <- api.toggle origin id
    signals.set next todos |> effects.mapError neverFailure
  }

effect fn applyDelete origin: String
  -> todos: MutableSignal<Array<Todo>>
  -> id: Int
  -> Unit
with httpClient: http.HttpClient
fails String =
  do {
    next <- api.delete origin id
    signals.set next todos |> effects.mapError neverFailure
  }

fn dispatchAction client: http.HttpClient
  -> origin: String
  -> todos: MutableSignal<Array<Todo>>
  -> draft: MutableSignal<String>
  -> action: Action
  -> Effect<{}, String, Unit> =
  effects.provideSome
    (\_environment: {} -> { httpClient: client })
    (match action {
      DraftChanged value -> setDraft (DraftCommand { value: value, draft: draft })
      AddTodo -> applyAdd origin todos draft
      ToggleTodo id -> applyToggle origin todos id
      DeleteTodo id -> applyDelete origin todos id
    })

pub effect fn run -> Unit
with dom: dom.Dom, httpClient: http.HttpClient, navigation: navigation.Navigation
fails String =
  do {
    location <- navigation.current () |> effects.mapError navigationFailure
    let origin = navigation.locationUrl location |> navigation.urlOrigin
    initial <- api.list origin
    todos <- signals.make initial |> effects.mapError neverFailure
    draft <- signals.make "" |> effects.mapError neverFailure
    client <- httpClientService () |> effects.mapError neverFailure

    let listRegion = signals.map region todos
    let bindings: Array<dom.DomBinding<Action>> = [
      dom.bindValue "#todo-input" draft,
      dom.bindRegion "#todo-list" listRegion
    ]
    let reactive = dom.content (islandContent actions initial "") bindings

    target <- dom.query "#todo-interactive"
      |> effects.mapError domQueryFailure

    dom.runContent hydrationOptions target (dispatchAction client origin todos draft) reactive
      |> effects.mapError domFailure
  }
