import * as dom from "std/web/dom"
import * as effects from "std/effect"
import * as http from "std/http"
import * as navigation from "std/web/navigation"
import * as queue from "std/queue"
import * as signals from "std/signal"
import { DomOptions } from "std/web/dom"
import { MutableSignal } from "std/signal"
import {
  Action,
  AddTodo,
  DeleteTodo,
  DraftChanged,
  Todo,
  ToggleTodo,
  list as todoList,
  view as todoView
} from "ui"
import * as api from "./api"

let defaultDomOptions = dom.defaultOptions ()
let hydrationOptions: DomOptions = DomOptions {
  ...defaultDomOptions,
  hydration: dom.HydrateStrict,
  cleanup: dom.PreserveRenderedDom
}

fn queueFailure _error: queue.QueueClosed -> String =
  "Todo action queue closed"

fn neverFailure _error: Never -> String =
  "unreachable"

fn domQueryFailure error: dom.DomError -> String =
  show error

fn domFailure error: dom.DomRuntimeError<String> -> String =
  show error

fn navigationFailure error: navigation.NavigationError -> String =
  navigation.errorMessage error

fn keep<A, B> value: A -> _ignored: B -> A =
  value

fn httpClientRequirement -> Effect<{ httpClient: http.HttpClient }, Never, http.HttpClient> =
  effects.service (\environment -> environment.httpClient)

fn httpSuccess<A> value: A
  -> Effect<{ httpClient: http.HttpClient }, String, A> =
  httpClientRequirement ()
  |> effects.mapError neverFailure
  |> map (keep value)

fn region todos: Array<Todo> -> dom.DomContent<Action> =
  dom.content (todoList todos) []

fn dispatch actions: queue.Queue<Action>
  -> action: Action
  -> Effect<{}, String, Unit> =
  queue.offer action actions
  |> effects.mapError queueFailure

fn setDraft value: String
  -> draft: MutableSignal<String>
  -> Effect<{ httpClient: http.HttpClient }, String, Unit> =
  flatMap
    (\_unit: Unit ->
      signals.set value draft
      |> effects.mapError neverFailure
    )
    (httpSuccess ())

effect fn insertTodo origin: String
  -> title: String
  -> todos: MutableSignal<Array<Todo>>
  -> draft: MutableSignal<String>
  -> Unit
with httpClient: http.HttpClient
fails String =
  do {
    next <- api.create origin title
    _ <- signals.set next todos
    signals.set "" draft
  }

effect fn applyAdd origin: String
  -> todos: MutableSignal<Array<Todo>>
  -> draft: MutableSignal<String>
  -> Unit
with httpClient: http.HttpClient
fails String =
  do {
    title <- signals.read draft
    if title == "" then
      httpSuccess ()
    else
      insertTodo origin title todos draft
  }

effect fn applyToggle origin: String
  -> todos: MutableSignal<Array<Todo>>
  -> id: Int
  -> Unit
with httpClient: http.HttpClient
fails String =
  do {
    next <- api.toggle origin id
    signals.set next todos
  }

effect fn applyDelete origin: String
  -> todos: MutableSignal<Array<Todo>>
  -> id: Int
  -> Unit
with httpClient: http.HttpClient
fails String =
  do {
    next <- api.delete origin id
    signals.set next todos
  }

pub effect fn worker origin: String
  -> actions: queue.Queue<Action>
  -> todos: MutableSignal<Array<Todo>>
  -> draft: MutableSignal<String>
  -> Unit
with httpClient: http.HttpClient
fails String =
  do {
    action <- queue.take actions |> effects.mapError queueFailure
    _ <- match action {
      DraftChanged value -> setDraft value draft
      AddTodo -> applyAdd origin todos draft
      ToggleTodo id -> applyToggle origin todos id
      DeleteTodo id -> applyDelete origin todos id
    }
    worker origin actions todos draft
  }

pub effect fn run -> Unit
with dom: dom.Dom, httpClient: http.HttpClient, navigation: navigation.Navigation
fails String =
  do {
    location <- navigation.current () |> effects.mapError navigationFailure
    let origin = navigation.locationUrl location |> navigation.urlOrigin
    initial <- api.list origin
    todos <- signals.make initial
    draft <- signals.make ""
    actions <- queue.unbounded<Action> ()

    let listRegion = signals.map region todos
    let bindings: Array<dom.DomBinding<Action>> = [
      dom.bindValue "#todo-input" draft,
      dom.bindRegion "#todo-list" listRegion
    ]
    let reactive = dom.content (todoView initial "") bindings

    target <- dom.query "#todo-app"
      |> effects.mapError domQueryFailure

    _ <- effects.fork (worker origin actions todos draft)

    dom.runContent hydrationOptions target (dispatch actions) reactive
      |> effects.mapError domFailure
  }
